# ---------------------------------------------------------------------------
# AtmoSync environment configuration (copy to .env and adjust values)
# ---------------------------------------------------------------------------

# Simulator
# SIMULATOR_INTERVAL_SECONDS=5
# SIMULATOR_DEVICE_COUNT=10
# SIMULATOR_OUTPUT_DIR=datasets/raw

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs

# Kafka (future)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC_SENSOR_READINGS=atmosync.sensor.readings

# Snowflake (future)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=

# dbt (future)
# DBT_PROFILES_DIR=./config

# Superset (future)
# SUPERSET_URL=
# SUPERSET_USERNAME=
# SUPERSET_PASSWORD=

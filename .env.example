# ---------------------------------------------------------------------------
# AtmoSync environment configuration (copy to .env and adjust values)
# ---------------------------------------------------------------------------

# Simulator
# SIMULATOR_INTERVAL_SECONDS=5
# SIMULATOR_DEVICE_COUNT=10
# SIMULATOR_OUTPUT_DIR=datasets/raw

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=atmosync.sensor.readings

# Kafka producer (optional overrides)
# KAFKA_PRODUCER_ACKS=all
# KAFKA_PRODUCER_RETRIES=3
# KAFKA_PRODUCER_LINGER_MS=5
# KAFKA_PRODUCER_BATCH_SIZE=16384
# KAFKA_PRODUCER_CLIENT_ID=atmosync-producer

# Optional compression (gzip, lz4, zstd, snappy). Leave unset for no compression.
# snappy requires the python-snappy package; gzip/lz4/zstd use built-in libraries.
# KAFKA_PRODUCER_COMPRESSION=gzip

# Kafka consumer (optional overrides)
# KAFKA_CONSUMER_GROUP_ID=atmosync-consumer
# KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
# KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=true
# KAFKA_CONSUMER_SESSION_TIMEOUT_MS=10000
# KAFKA_CONSUMER_CLIENT_ID=atmosync-consumer

# Snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=


# dbt (future)
# DBT_PROFILES_DIR=./config

# Superset (future)
# SUPERSET_URL=
# SUPERSET_USERNAME=
# SUPERSET_PASSWORD=
